# ===== EngFlow .gitignore =====

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---------- Java / Maven / Spring Boot ----------
HELP.md
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
build/
!**/src/main/**/build/
!**/src/test/**/build/
.springBeans
.classpath
.factorypath
.project
.settings/
.sts4-cache
.apt_generated

# ---------- IDEs ----------
.idea/
*.iws
*.iml
*.ipr
.vscode/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ---------- Environment & Secrets ----------
.env
.env.*
!src/main/resources/application.properties.example

# ---------- Node / Frontend / Crawler ----------
node_modules/
dist/
frontend/dist/
crawler/dist/
crawler/node_modules/
frontend/node_modules/
.cache/
.parcel-cache/

# ---------- Logs ----------
*.log
*.err
logs/
*.out
vite-*.txt
*hs_err_pid*.log
replay_pid*.log

# ---------- Runtime Artifacts ----------
backend.pid
*.pid
uploads/

# ---------- Debug / Temp / One-off Scripts ----------
*.tmp
*.tmp-*
*.bak
*.orig
*.rej
diag_*.json
diag_*.log
*.network-request
*.network-response
*_dump.json
api_tokens.txt
*tokens*.txt
api_smoke.ps1
api_audit_*.ps1
verify_*.ps1
check_*.ps1
final_*.ps1
smoke_*.ps1
tmp_*.json
tmp_*.txt
tmp_*.sql
run_*.ps1
db_*.sql
create_*.sql
reset_*.sql
test_*.ps1
diag_*.ps1
compile_*.txt
compile_*.log
final_*.txt
full_*.txt
test_*.txt
*_check.txt
csp_*.txt
compile_out.txt
ui_report_utf8.md
mcp.json
mcp.json.backup-*
mcp_config.json
.agents/mcp_config.json
skills-lock.json

# ---------- Browser / MCP / Playwright ----------
.ua/
.ua-screens/
.playwright-mcp/
frontend/.playwright-mcp/
.playwright/
chrome-wrapper.*
.brave-debug-user-data/
crawler/output/
crawler/.cache/

# ---------- Tailscale / Ngrok (never commit node auth + serve/funnel state) ----------
.tailscale/
tailscaled.*
ngrok-stderr.txt
ngrok-stdout.txt
ngrok.yml
home.png
winget-tailscale*.log
derpmap.cached.json

# ---------- Misc ----------
fsmonitor--daemon
*.tmp-qr*.png
.tmp-qrtool/
.rt*.png
.tmp-order*.txt

# ---------- Generated audio in static dir (keep folder, ignore content) ----------
src/main/resources/static/audio/*.mp3
# frontend/public/e2e-tts.wav is tracked (per AGENTS.md)

# ---------- 0-byte accidental file from old shell sessions ----------
/$null

# ---------- Local probe artifacts (contain live tokens / scratch data) ----------
login-admin.json
login-user.json
e.json
check1.txt
wrong.json
openapi.json
sweep/*.token
sweep/*.tmp
sweep/login.json
sweep/order.json
sweep/body-r3.json
.p0-backend-test.log

# ---------- Audit artifacts (local only) ----------
.mimosa/
audit-v*-*.json
audit-v*-shots/
*.network-request
*.network-response
