SA_PASSWORD=YourPassword123
# Host-side Spring app/test đọc qua spring.config.import (phải trùng SA_PASSWORD)
DB_PASSWORD=YourPassword123
JWT_SECRET=CHANGE_ME_min_32_chars_random_base64

# MinIO (local object storage — audio, file uploads)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_strong_password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_a_strong_password
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=speaking-uploads

# Cloudinary (CDN cho audio listening + avatar upload; demo/demo/demo = fail-soft)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# Ollama local AI (không cần API key)
AI_SPEAKING_OLLAMA_BASE_URL=http://localhost:11434
AI_SPEAKING_OLLAMA_MODEL=qwen2.5:1.5b

# OpenRouter (vocab gen) — placeholder rơi về Ollama local
OPENROUTER_API_KEY=your_openrouter_api_key

# Gmail SMTP (forgot-password email) — placeholder = fail-soft
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# SePay (payment VN) — BANK_NAME là mã ngắn SePay (MBBank, VietcomBank, ...)
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
SEPAY_BANK_ACCOUNT=your_bank_account
SEPAY_BANK_NAME=your_bank_name
SEPAY_API_TOKEN=your_sepay_api_token
