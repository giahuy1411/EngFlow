# Speaking Coach AI
AI_SPEAKING_OLLAMA_BASE_URL=http://localhost:11434
AI_SPEAKING_OLLAMA_MODEL=qwen2.5:1.5b

# SePay
# Webhook secret: my.sepay.vn -> Cai dat -> Webhooks (per-webhook secret, "whsec_...")
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
SEPAY_BANK_ACCOUNT=your_bank_account
SEPAY_BANK_NAME=your_bank_name
# API token for the polling fallback (webhook backup): my.sepay.vn ->
# Cau hinh Cong ty -> API Access -> + Them API. Empty = polling disabled.
# Docs: https://docs.sepay.vn/tao-api-token.html + https://docs.sepay.vn/api-giao-dich.html
SEPAY_API_TOKEN=your_sepay_api_token
